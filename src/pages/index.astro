---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusMeta from '../components/StatusMeta.astro';
import Pdo from '../components/Pdo.astro';
import { site } from '../site';
import { published } from '../lib/posts';
import '../styles/pages/home.css';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
// The newest Published post leads readers from here into the reading side of the site.
const latest = published[0] || null;
const fmt = (d: string | null) => (d ? new Date(`${d.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '');
const drop = 'M12 2.5C12 2.5 5.2 10.4 5.2 15.2a6.8 6.8 0 0 0 13.6 0C18.8 10.4 12 2.5 12 2.5Z';
---
<Base page="home" title={site.name}>
  <main class="panes">
    <div class="pane-pitch">
      <p class="avail mono-meta"><span class="dot"></span>Open to new roles</p>
      <h1 class="h1 home-h1">I write the code for when things go wrong.</h1>
      <p class="sub">Senior full-stack .NET engineer.</p>
      <dl class="facts">
        <div><dt class="mono-label">Stack</dt><dd>C#, .NET, Blazor</dd></div>
        <div><dt class="mono-label">Cloud</dt><dd>Azure</dd></div>
        <div><dt class="mono-label">Focus</dt><dd>APIs, design systems</dd></div>
      </dl>
      <div class="actions">
        <a class="btn btn-primary resume-btn" href={site.resume}>Résumé (PDF)</a>
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email me</a>
      </div>

      {latest && (
        <section class="latest" aria-labelledby="latest-title">
          <p class="latest-top mono-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop}></path></svg>Latest post{latest.published && <> · {fmt(latest.published)}</>}</p>
          <a class="latest-link" href={`/posts/${latest.slug}/`}>
            <span class="latest-title" id="latest-title">{latest.title}</span>
            {latest.hook && <span class="latest-hook">{latest.hook}</span>}
            <span class="latest-foot"><span class="mono-meta">{latest.minutes} min{latest.cardCount > 0 && ` · ${latest.cardCount} claims`}</span><span class="latest-go">Read it <span aria-hidden="true">→</span></span></span>
          </a>
          <a class="latest-all mono-meta" href="/posts/">All posts →</a>
        </section>
      )}
    </div>

    <div class="pane-main">
      <div class="log-head"><span class="mono-label">ID</span><span class="mono-label strong">Decision log</span></div>
      {cases.map(({ id, data }) => (
        <details class="log-row">
          <summary>
            <span class="id">{data.id}</span>
            <span class="main">
              <span class="title">{data.title}</span>
              <StatusMeta status={data.status} stack={data.stack} />
            </span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <div class="panel">
            <span></span>
            <div>
              <Pdo tldr={data.tldr} />
              <div class="row-actions">
                {data.published
                  ? <a class="btn btn-primary open" href={`/case/${id}/`}>Open the case file →</a>
                  : <span class="mono-meta">Case file coming soon</span>}
                {data.app && <a class="btn btn-secondary open" href={data.app}>{/^https?:/.test(data.app) ? 'Visit the site' : 'Try the app'}</a>}
                {data.published && <span class="mono-meta">{data.readMinutes} min read</span>}
              </div>
            </div>
          </div>
        </details>
      ))}

      <div class="cards">
        <a class="card" href="/pocket-log/">
          <span class="card-top"><span class="mono-label">App</span><span aria-hidden="true">→</span></span>
          <span class="card-title">Pocket Log</span>
          <span class="card-desc">My bowling analytics app, built on my own league data. Browse it read-only, or try the sandbox.</span>
        </a>
        <a class="card" href="/library/">
          <span class="card-top"><span class="mono-label">Library</span><span aria-hidden="true">→</span></span>
          <span class="card-title">What I'm reading</span>
          <span class="card-desc">Books I've read, my reviews, and the notes I took in my Zettelkasten. Synced from Notion.</span>
        </a>
        <a class="card" href="#">
          <span class="card-top"><span class="mono-label">Notes · coming soon</span><span aria-hidden="true">→</span></span>
          <span class="card-title">How I build with AI</span>
          <span class="card-desc">Where AI speeds me up, where I don't trust it, and how I check its work.</span>
        </a>
      </div>
    </div>
  </main>
</Base>
