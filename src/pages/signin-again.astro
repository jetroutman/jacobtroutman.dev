---
// Shown in place of a 403 on /admin/: usually the sign-in didn't carry the admin role this time.
import Base from '../layouts/Base.astro';
---
<Base title="Sign in again" noindex>
  <div class="wrap">
    <p class="mono-meta">Admin</p>
    <h1 class="h1">Sign in again</h1>
    <p class="desc">This sign-in didn't carry the admin role. Signing in again usually fixes it.</p>
    <p><a class="btn btn-primary" href="/.auth/login/github?post_login_redirect_uri=/admin/">Sign in with GitHub</a></p>
    <p class="mono-meta">Still here after that? This GitHub account doesn't have the admin role.</p>
  </div>
</Base>
<style>
  .wrap { max-width: 640px; padding-top: clamp(28px, 5vw, 64px); display: grid; gap: 14px; }
  .desc { color: var(--muted); font-size: 17px; }
</style>
