---
import Base from '../layouts/Base.astro';
import '../styles/pages/pocket-log.css';
---
<Base page="pocket-log" title="Pocket Log" description="My bowling analytics app, built on my own league data.">
  <div class="layout">
  <div class="side">
  <div class="intro">
    <p class="mono-meta"><a href="/" data-back>← Decision log</a> / Pocket Log</p>
    <div class="intro-row">
      <div class="left">
        <div class="meta"><span class="pill">In progress</span><span class="mono-meta">LLM</span></div>
        <h1 class="h1">Pocket Log</h1>
        <p class="desc">My bowling analytics app, built on my own league data. Browse it read-only, or try the sandbox.</p>
      </div>
    </div>
  </div>

  <div class="banner" data-banner data-mode="real">
    <p role="status" class="status"><span class="dot"></span><span data-status>Viewing Jacob's real league data (read-only)</span></p>
    <div class="controls">
      <button type="button" class="reset" data-reset hidden>Reset sandbox</button>
      <div class="seg" role="group" aria-label="Data mode">
        <button type="button" data-set="real" aria-pressed="true">Real data</button>
        <button type="button" data-set="sandbox" aria-pressed="false">Sandbox</button>
      </div>
    </div>
  </div>

  </div>
  <div class="main">
  <div class="frame">
    <div class="strip"><span class="mono-label">Pocket Log · phone-first, works best on mobile</span><span class="mono-label" data-source>Data: league snapshot</span></div>
    <iframe class="app" data-app src="/pocket-log/app/?mode=real" title="Pocket Log app" loading="eager"></iframe>
  </div>
  <p class="mono-meta foot">Sandbox data is saved in this browser's local storage and never sent anywhere. Reset restores my real data. Live AI coaching isn't on the site yet; the coaching you see is what the app wrote for my real league nights.</p>
  </div>
  </div>
</Base>

<script>
  const banner = document.querySelector<HTMLElement>('[data-banner]')!;
  const status = document.querySelector('[data-status]')!;
  const source = document.querySelector('[data-source]')!;
  const frame = document.querySelector<HTMLIFrameElement>('[data-app]')!;
  const reset = document.querySelector<HTMLButtonElement>('[data-reset]')!;
  const buttons = [...banner.querySelectorAll<HTMLButtonElement>('[data-set]')];
  let mode = 'real';
  // Opened from a company page: back link returns to the slide they left, and that page plays "Took it for a spin".
  const from = new URLSearchParams(location.search).get('from');
  const fromOk = !!from && /^\/for\/[a-z0-9-]+\/(#[a-z0-9-]+)?$/.test(from);
  if (fromOk) {
    const back = document.querySelector<HTMLAnchorElement>('[data-back]')!;
    back.href = from!; back.textContent = '← Back to your page';
    try { localStorage.setItem(`jt-app-${from!.split('/')[2]}`, '1'); } catch {}
  }
  function set(next: string, push = true) {
    mode = next;
    banner.dataset.mode = mode;
    status.textContent = mode === 'sandbox'
      ? 'Sandbox: your changes stay in your browser'
      : "Viewing Jacob's real league data (read-only)";
    source.textContent = mode === 'sandbox' ? 'Data: this browser' : 'Data: league snapshot';
    reset.hidden = mode !== 'sandbox';
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.set === mode));
    frame.src = `/pocket-log/app/?mode=${mode}`;
    if (push) {
      const q = new URLSearchParams();
      if (mode === 'sandbox') q.set('mode', 'sandbox');
      if (fromOk) q.set('from', from!);
      history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
    }
  }
  buttons.forEach((b) => b.addEventListener('click', () => { if (b.dataset.set !== mode) set(b.dataset.set!); }));
  reset.addEventListener('click', () => {
    try { localStorage.removeItem('pocketlog.sandbox.v1'); } catch {}
    frame.src = `/pocket-log/app/?mode=sandbox&r=${Date.now()}`;
  });
  if (new URLSearchParams(location.search).get('mode') === 'sandbox') set('sandbox', false);

  // Messages from the embedded app: its height, "scroll to top" on tab change, and read-only nudges.
  addEventListener('message', (e) => {
    if (e.origin !== location.origin || e.source !== frame.contentWindow || e.data?.src !== 'pocket-log') return;
    if (e.data.type === 'height') frame.style.height = `${Math.max(480, e.data.h)}px`;
    if (e.data.type === 'top') {
      const top = frame.getBoundingClientRect().top + scrollY - banner.offsetHeight - 24;
      if (scrollY > top) scrollTo({ top });
    }
    if (e.data.type === 'readonly') {
      banner.classList.remove('nudge'); void banner.offsetWidth; banner.classList.add('nudge');
    }
  });
</script>
