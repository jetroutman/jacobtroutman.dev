---
import Base from '../layouts/Base.astro';
---
<Base title="Pocket Log" description="My bowling analytics app, built on my own league data.">
  <div class="intro">
    <p class="mono-meta"><a href="/">← Decision log</a> / Pocket Log</p>
    <div class="intro-row">
      <div class="left">
        <div class="meta"><span class="pill">In progress</span><span class="mono-meta">LLM</span></div>
        <h1 class="h1">Pocket Log</h1>
        <p class="desc">My bowling analytics app, built on my own league data. Browse it read-only, or try the sandbox.</p>
      </div>
    </div>
  </div>

  <div class="banner" data-banner data-mode="real">
    <p role="status" class="status"><span class="dot"></span><span data-status>Viewing Jacob's real league data (read-only)</span></p>
    <div class="seg" role="group" aria-label="Data mode">
      <button type="button" data-set="real" aria-pressed="true">Real data</button>
      <button type="button" data-set="sandbox" aria-pressed="false">Sandbox</button>
    </div>
  </div>

  <div class="frame">
    <div class="strip"><span class="mono-label">Stand-in · the Pocket Log app mounts here</span><span class="mono-label" data-source>Data: league snapshot</span></div>
    <div class="placeholder">
      {/* TODO: replace with the Pocket Log island. It owns the banner state (real | sandbox). */}
      <p>The app is being ported from its prototype. Real data and sandbox modes arrive with it.</p>
    </div>
  </div>
  <p class="mono-meta foot">Sandbox data is saved in this browser's local storage and never sent anywhere. Reset restores my real data.</p>
</Base>

<script>
  const banner = document.querySelector<HTMLElement>('[data-banner]')!;
  const status = document.querySelector('[data-status]')!;
  const source = document.querySelector('[data-source]')!;
  const buttons = [...banner.querySelectorAll<HTMLButtonElement>('[data-set]')];
  function set(mode: string) {
    banner.dataset.mode = mode;
    status.textContent = mode === 'sandbox'
      ? 'Sandbox: your changes stay in your browser'
      : "Viewing Jacob's real league data (read-only)";
    source.textContent = mode === 'sandbox' ? 'Data: this browser' : 'Data: league snapshot';
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.set === mode));
  }
  buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.set!)));
  if (new URLSearchParams(location.search).get('mode') === 'sandbox') set('sandbox');
</script>

<style>
  .intro { padding-top: clamp(28px, 5vw, 64px); }
  .intro a { text-decoration: none; }
  .intro-row { margin-top: clamp(20px, 3vw, 32px); }
  .meta { display: flex; gap: 10px; align-items: center; }
  h1 { margin-top: 12px; font-size: clamp(34px, 4.4vw, 52px); line-height: 1.02; }
  .desc { margin-top: 12px; max-width: 36em; font-size: 17px; line-height: 1.5; color: var(--muted); }

  .banner {
    position: sticky; top: 8px; z-index: 10; margin-top: clamp(24px, 4vw, 40px);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px;
    padding: 10px 10px 10px 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface);
  }
  .banner[data-mode="sandbox"] { border-color: var(--amber); background: var(--amber-tint); }
  .status { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 500; line-height: 1.4; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ink); flex: none; }
  .banner[data-mode="sandbox"] .dot { background: var(--amber); }
  .seg { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); }
  .banner[data-mode="sandbox"] .seg { border-color: var(--amber); }
  .seg button {
    position: relative; min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px;
    background: transparent; font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .seg button::before { content: ""; position: absolute; inset: -7px 0; }
  .seg button:hover { background: var(--hover); }
  .seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }

  .frame { margin-top: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; }
  .strip { display: flex; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
  .placeholder { padding: 48px 16px; text-align: center; color: var(--muted); }
  .foot { margin-top: 14px; }
</style>
