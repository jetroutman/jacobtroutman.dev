---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusMeta from '../../components/StatusMeta.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  // Drafts build in dev and in PR preview builds (PUBLIC_DRAFTS), never in production.
  const showDrafts = import.meta.env.DEV || import.meta.env.PUBLIC_DRAFTS === 'true';
  const pages = await getCollection('companies', (c) => showDrafts || !c.data.draft);
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { data, id: slug } = Astro.props.entry;
const cases = Object.fromEntries((await getCollection('cases')).map((c) => [c.data.id, c]));
const evidence = data.evidence.filter((e) => cases[e.case]);

/*
 * The page is a deck: one section per screen, snapped with native CSS scroll-snap
 * (no scroll hijacking). Gamification: a progress bar pinned to the top, sections
 * that reveal as they arrive, and a final note that unlocks once every slide is seen.
 * Without JS it is a plain, fully visible page.
 */
const slides = [
  { id: 'intro', label: 'Intro' },
  { id: 'fit', label: 'What you asked for' },
  ...evidence.map((_, i) => ({ id: `evidence-${i + 1}`, label: `Evidence ${i + 1} of ${evidence.length}` })),
  { id: 'plan', label: 'First 90 days' },
  { id: 'questions', label: 'My questions' },
  ...(data.bonus ? [{ id: 'note', label: data.bonus.label }] : []),
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title={`Why I fit ${data.company}`}
  noindex
  footerNote={`Unlisted page for ${data.company}. Not linked from the rest of the site.`}
>
  <script is:inline>document.documentElement.classList.add('deck-js');</script>

  <div class="deck" data-deck={slug} data-company={data.company}>
    <nav class="deckbar" aria-label="Sections">
      <ol class="segs">
        {slides.map((s, i) => (
          <li><a class="seg" href={`#${s.id}`} data-seg={s.id} aria-label={`${pad(i + 1)}: ${s.label}`}><span></span></a></li>
        ))}
      </ol>
      <span class="mono-meta bar-pos" aria-live="polite"><span data-pos>01</span> / {pad(slides.length)}<span class="bar-label"> · <span data-label>Intro</span></span></span>
      <div class="hud">
        <span class="mono-meta hud-game dist" title="Cursor distance, in 60 ft bowling lanes"><span data-dist-label>Cursor</span> <span data-dist>0.00 lanes</span></span>
        <button type="button" class="hud-btn hud-game" data-ach-open aria-expanded="false" aria-controls="ach-panel">Achievements <span data-ach-count>0/12</span></button>
        <button type="button" class="hud-btn game-toggle" data-game-toggle aria-pressed="true">Game <span data-game-state>on</span></button>
      </div>
    </nav>

    <section id="intro" class="slide intro" data-slide>
      <div class="inner">
        <p class="mono-meta reveal"><span class="chip">Unlisted</span> Prepared for {data.company} · {data.date}</p>
        <h1 class="h1 reveal">Why I fit {data.company}</h1>
        <p class="role reveal">{data.role}</p>
        <p class="statement reveal">{data.summary}</p>
        <div class="actions reveal">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
          <a class="btn btn-secondary" href={site.resume}>Résumé (PDF)</a>
        </div>
        <p class="mono-meta hint reveal" aria-hidden="true">Scroll down, I'll walk you through it ↓</p>
        <p class="game-note reveal">Fair warning: I turned this page into a small game. There are achievements, a few secrets, and a note at the end that only opens once you've seen everything. <button type="button" class="link-btn" data-game-toggle aria-pressed="true">Turn the game <span data-game-flip>off</span></button></p>
      </div>
    </section>

    <section id="fit" class="slide" data-slide>
      <div class="inner">
        <div class="section-head reveal"><span class="num">01</span><h2>Your wishlist, checked off</h2></div>
        <div class="matrix reveal">
          <div class="mrow mhead"><span class="mono-label">You asked for</span><span class="mono-label">Where I've already done it</span></div>
          {data.requirements.map((r) => (
            <div class="mrow"><span>{r.need}</span><span class="ids">{r.cases.map((c) => (
              cases[c]?.data.published
                ? <a class="idchip" href={`/case/${cases[c].id}/`} data-case-link>{c}</a>
                : <a class="idchip" href={`#evidence-${evidence.findIndex((e) => e.case === c) + 1}`}>{c}</a>
            ))}</span></div>
          ))}
        </div>
      </div>
    </section>

    {evidence.map((e, i) => {
      const c = cases[e.case];
      return (
        <section id={`evidence-${i + 1}`} class="slide" data-slide data-evidence>
          <div class="inner">
            <div class="section-head reveal"><span class="num">02</span><h2>Exhibit {String.fromCharCode(65 + i)}</h2>{c.data.teaser && <span class="teaser">{c.data.teaser}</span>}<span class="mono-meta count">{i + 1} of {evidence.length}</span></div>
            <div class="ev">
              <p class="ev-id reveal">{c.data.id}</p>
              <h3 class="ev-title reveal">{c.data.title}</h3>
              <div class="reveal ev-meta"><StatusMeta status={c.data.status} stack={c.data.stack} /></div>
              <p class="ev-rel reveal"><strong>For {data.company}:</strong> {e.relevance}</p>
              {c.data.quiz ? (
                <div class="quiz reveal" data-quiz={c.data.id}>
                  <div class="pdo"><p class="mono-label">Problem</p><p>{c.data.tldr.problem}</p></div>
                  <div class="ask">
                    <p class="mono-label ask-label">What would you have done?</p>
                    <p class="ask-q">{c.data.quiz.question}</p>
                    <div class="opts">
                      {c.data.quiz.options.map((o, oi) => (
                        <button type="button" class="opt" data-option={oi} data-chosen={o.chosen ? '' : undefined}>
                          <span class="opt-key">{String.fromCharCode(65 + oi)}</span><span>{o.label}</span>
                        </button>
                      ))}
                    </div>
                    {c.data.quiz.options.map((o, oi) => (
                      <p class="reply" data-reply={oi} hidden><span class="mono-label">{o.chosen ? 'Great minds. That\'s what I shipped.' : 'Tempting. Here\'s why I didn\'t.'}</span> {o.reply}</p>
                    ))}
                  </div>
                  <div class="ev-pdo after">
                    <div class="pdo"><p class="mono-label">Decision</p><p>{c.data.tldr.decision}</p></div>
                    <div class="pdo"><p class="mono-label">Outcome</p><p>{c.data.tldr.outcome}</p></div>
                  </div>
                </div>
              ) : (
                <div class="ev-pdo reveal">
                  <div class="pdo"><p class="mono-label">Problem</p><p>{c.data.tldr.problem}</p></div>
                  <div class="pdo"><p class="mono-label">Decision</p><p>{c.data.tldr.decision}</p></div>
                  <div class="pdo"><p class="mono-label">Outcome</p><p>{c.data.tldr.outcome}</p></div>
                </div>
              )}
              <div class="reveal ev-cta">
                {c.data.published
                  ? <a class="btn btn-primary" href={`/case/${c.id}/`} data-case-link>Open the case file →</a>
                  : <span class="mono-meta">Full case file coming soon</span>}
                {c.data.published && <span class="mono-meta">{c.data.readMinutes} min read</span>}
              </div>
            </div>
          </div>
        </section>
      );
    })}

    <section id="plan" class="slide" data-slide>
      <div class="inner">
        <div class="section-head reveal"><span class="num">03</span><h2>How my first 90 days would go</h2></div>
        <div class="plan">
          {data.plan.map((p, pi) => (
            <div class="phase reveal">
              <p class="mono-label">Level {pi + 1} · {p.days}</p>
              <h3>{p.title}</h3>
              <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="questions" class="slide" data-slide>
      <div class="inner">
        <div class="section-head reveal"><span class="num">04</span><h2>Your turn. I've got questions too.</h2></div>
        <ol class="questions">
          {data.questions.map((q, i) => <li class="reveal"><span class="q">Q{i + 1}</span><span>{q}</span></li>)}
        </ol>
      </div>
    </section>

    {data.bonus && (
      <section id="note" class="slide" data-slide data-note>
        <div class="inner">
          <div class="section-head reveal"><span class="num">05</span><h2>One more thing</h2></div>
          <div class="locked reveal" data-locked hidden>
            <p class="mono-label">Locked · {data.bonus.label}</p>
            <p class="locked-title">A note I wrote just for {data.company}</p>
            <p class="locked-body">Locked. Finish the run to open it. <span data-left></span></p>
          </div>
          <aside class="bonus reveal" data-bonus>
            <p class="mono-label bonus-label">Unlocked · {data.bonus.label}</p>
            <h3>{data.bonus.title}</h3>
            <p>{data.bonus.body}</p>
            <div class="actions"><a class="btn btn-primary" href={`mailto:${site.email}`}>Let's talk</a></div>
          </aside>
          <div class="summary reveal hud-game" data-summary>
            <p class="mono-label">How your run went</p>
            <dl class="stats">
              <div><dt class="mono-label">Achievements</dt><dd data-s-ach>0 / 12</dd></div>
              <div><dt class="mono-label">Distance</dt><dd data-s-dist>0.0 m</dd></div>
              <div><dt class="mono-label">Bowling lanes</dt><dd data-s-lanes>0.00 lanes</dd></div>
              <div><dt class="mono-label">Time</dt><dd data-s-time>0m 00s</dd></div>
              <div><dt class="mono-label">Slides</dt><dd data-s-slides>0 / {slides.length}</dd></div>
            </dl>
            <div class="actions">
              <a class="btn btn-primary" data-mail={site.email} href={`mailto:${site.email}`}>Send me your score</a>
              <button type="button" class="btn btn-secondary" data-copy>Copy score</button>
            </div>
            <p class="mono-meta privacy">I can't see any of this. It's counted in your browser and only reaches me if you send it.</p>
          </div>
        </div>
      </section>
    )}
  </div>

  <div class="toasts" data-toasts aria-live="polite"></div>
  <div class="ach-panel" id="ach-panel" data-ach-panel hidden role="dialog" aria-label="Achievements">
    <div class="ach-head"><span class="mono-label" style="color:var(--ink)">Achievements</span><span class="mono-meta" data-ach-hidden></span><button type="button" class="hud-btn" data-ach-close>Close</button></div>
    <ol class="ach-list" data-ach-list></ol>
  </div>
</Base>

<script>
  import { initDeck } from '../../scripts/deck-game';
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) initDeck(deck);
</script>

<style>
  /* Snap only on this page. Mandatory on roomy screens, proximity where slides may outgrow the screen. */
  :global(html:has(.deck)) { scroll-snap-type: y mandatory; scroll-padding-top: var(--bar-h); --bar-h: 44px; }
  @media (max-height: 700px), (max-width: 700px) { :global(html:has(.deck)) { scroll-snap-type: y proximity; } }
  @media (prefers-reduced-motion: reduce) { :global(html:has(.deck)) { scroll-snap-type: y proximity; } }
  :global(html:has(.deck) .site-header) { scroll-snap-align: start; }
  :global(html:has(.deck) .site-footer) { scroll-snap-align: end; }

  .deckbar {
    position: sticky; top: 0; z-index: 20; height: var(--bar-h);
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px;
    margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter);
    background: var(--bg); border-bottom: 1px solid var(--line);
  }
  .segs { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; }
  .segs li { flex: 1; }
  .seg { position: relative; display: block; padding: 10px 0; }
  .seg span { display: block; height: 4px; border-radius: 999px; background: var(--line); transition: background 200ms ease-out; }
  .seg.done span { background: var(--amber); }
  .seg.current span { background: var(--ink); }
  .seg:hover span { background: var(--muted); }
  .deckbar { grid-template-columns: 1fr auto auto; }
  .bar-pos { white-space: nowrap; }
  .hud { display: flex; align-items: center; gap: 8px; }
  .hud-btn {
    position: relative; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--line); background: var(--surface); border-radius: 999px;
    padding: 4px 10px; font: 12px var(--mono); color: var(--ink);
  }
  .hud-btn::before { content: ""; position: absolute; inset: -8px -2px; }
  .hud-btn:hover { border-color: var(--ink); }
  .game-toggle[aria-pressed="true"] { border-color: var(--amber); background: var(--amber-tint); color: var(--amber-ink); }
  .dist { white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) { .bar-label, .dist { display: none; } }
  @media (max-width: 520px) { .bar-pos { display: none; } .deckbar { grid-template-columns: 1fr auto; gap: 10px; } }
  :global(.game-off) .hud-game { display: none !important; }

  .game-note { margin-top: 14px; font-size: 14px; color: var(--muted); }
  .link-btn { border: 0; background: none; padding: 0; font: inherit; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .link-btn:hover { color: var(--amber-ink); }

  .quiz { margin-top: 24px; display: grid; gap: 20px; }
  .ask { padding: 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .ask-label { color: var(--amber-ink); }
  .ask-q { margin-top: 8px; font-size: 19px; font-weight: 600; line-height: 1.35; }
  .opts { margin-top: 14px; display: grid; gap: 8px; }
  .opt {
    display: flex; gap: 12px; align-items: flex-start; text-align: left; cursor: pointer;
    min-height: 44px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg);
    font-size: 16px; line-height: 1.4;
  }
  .opt:hover:not(:disabled) { border-color: var(--ink); }
  .opt:disabled { cursor: default; opacity: 0.55; }
  .opt.picked { opacity: 1; border: 2px solid var(--amber); padding: 9px 13px; background: var(--amber-tint); }
  .opt-key { font: 12px/1.9 var(--mono); color: var(--muted); }
  .reply { margin-top: 14px; font-size: 16px; line-height: 1.55; }
  .reply .mono-label { display: block; margin-bottom: 4px; color: var(--amber-ink); }
  .quiz .after { display: none; }
  .quiz.answered .after { display: grid; }
  :global(.game-off) .ask { display: none; }
  :global(.game-off) .quiz .after { display: grid; }

  .summary { margin-top: 20px; padding: clamp(18px, 2.4vw, 28px); border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .stats { margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 14px 20px; }
  .stats dd { margin: 4px 0 0; font: 500 22px var(--mono); font-variant-numeric: tabular-nums; }
  .privacy { margin-top: 14px; }

  /* Achievement pop: top-center, game-style. */
  .toasts { position: fixed; z-index: 60; bottom: 24px; left: 50%; transform: translateX(-50%); width: min(440px, calc(100vw - 24px)); pointer-events: none; }
  :global(.pop) {
    pointer-events: auto; position: relative; overflow: hidden; width: 100%; cursor: pointer; text-align: left;
    display: grid; grid-template-columns: 56px 1fr; gap: 14px; align-items: center;
    padding: 14px 18px 14px 14px; border: 0; border-radius: 16px;
    background: var(--ink); color: var(--bg); font: inherit;
    box-shadow: 0 0 0 1px var(--amber), 0 18px 48px -12px rgb(0 0 0 / 0.45);
  }
  :global(.pop-badge) {
    position: relative; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center; background: var(--amber); color: #15191E;
    font: 600 18px var(--mono);
  }
  :global(.pop-badge)::after {
    content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--amber);
    animation: pop-ring 1100ms ease-out 300ms both;
  }
  :global(.pop-body) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  :global(.pop-tag) { font: 11px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); }
  :global(.pop-title) { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  :global(.pop-desc) { font-size: 14px; opacity: 0.85; line-height: 1.4; }
  :global(.pop-hint) { margin-top: 4px; font: 11px var(--mono); opacity: 0.65; }
  :global(.pop-shine) {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
    transform: translateX(-120%); animation: pop-shine 900ms ease-out 380ms forwards;
  }
  :global(.pop.secret) { background: var(--amber); color: #15191E; box-shadow: 0 0 0 1px var(--amber), 0 18px 48px -12px rgb(0 0 0 / 0.45); }
  :global(.pop.secret .pop-badge) { background: #15191E; color: var(--amber); }
  :global(.pop.secret .pop-badge)::after { border-color: #15191E; }
  :global(.pop.secret .pop-tag) { color: #15191E; font-weight: 600; }
  @keyframes pop-ring { from { transform: scale(0.9); opacity: 1; } to { transform: scale(1.7); opacity: 0; } }
  @keyframes pop-shine { to { transform: translateX(120%); } }
  @media (prefers-reduced-motion: reduce) { :global(.pop-badge)::after, :global(.pop-shine) { animation: none; display: none; } }
  .hud-btn:global(.flash) { border-color: var(--amber); background: var(--amber-tint); color: var(--amber-ink); transition: background 300ms, color 300ms; }

  .ach-panel {
    position: fixed; z-index: 40; top: 52px; right: 16px; width: min(360px, calc(100vw - 32px));
    max-height: calc(100svh - 72px); overflow: auto; padding: 14px 16px;
    border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
  }
  .ach-head { display: flex; align-items: center; gap: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--ink); }
  .ach-head [data-ach-hidden] { margin-left: auto; }
  .ach-list { list-style: none; margin: 0; padding: 0; }
  .ach-list :global(li) { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .ach-list :global(.ach-title) { font-size: 15px; font-weight: 600; }
  .ach-list :global(.ach-desc) { margin-top: 2px; font-size: 13px; color: var(--muted); }
  .ach-list :global(li.todo .ach-title) { color: var(--muted); }
  .ach-list :global(li.got .ach-title)::before { content: "✓ "; color: var(--amber-ink); font-family: var(--mono); }

  .slide {
    min-height: calc(100svh - var(--bar-h)); scroll-snap-align: start;
    display: grid; align-content: center; padding: clamp(40px, 6vh, 72px) 0;
  }
  .inner { width: 100%; max-width: 980px; }
  .intro .inner { max-width: 820px; }

  /* Reveal: content rises in when its slide arrives, then stays. */
  :global(.deck-js) .reveal { opacity: 0; transform: translateY(14px); transition: opacity 420ms ease-out, transform 420ms ease-out; }
  :global(.deck-js) .shown .reveal { opacity: 1; transform: none; }
  .shown .reveal:nth-child(2) { transition-delay: 60ms; }
  .shown .reveal:nth-child(3) { transition-delay: 120ms; }
  .shown .reveal:nth-child(4) { transition-delay: 180ms; }
  .shown .reveal:nth-child(5) { transition-delay: 240ms; }
  .shown .reveal:nth-child(n+6) { transition-delay: 300ms; }
  @media (prefers-reduced-motion: reduce) {
    :global(.deck-js) .reveal { transform: none; transition: opacity 200ms linear; transition-delay: 0ms !important; }
  }

  .chip { border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; margin-right: 6px; }
  h1 { margin-top: 18px; font-size: clamp(40px, 6vw, 76px); line-height: 1; }
  .role { margin-top: 16px; font-size: 18px; line-height: 1.45; color: var(--muted); }
  .statement { margin-top: 28px; max-width: 32em; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.4; font-weight: 500; }
  .hint { margin-top: clamp(32px, 6vh, 64px); }

  h2 { font-size: clamp(24px, 2.6vw, 34px); font-weight: 600; line-height: 1.2; letter-spacing: -0.015em; }
  .section-head .count { margin-left: auto; }
  .teaser { font-size: clamp(15px, 1.4vw, 17px); color: var(--muted); }
  @media (max-width: 700px) { .teaser { display: none; } }

  .matrix { margin-top: 32px; }
  .mrow { display: grid; grid-template-columns: 1.3fr 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: clamp(16px, 1.6vw, 19px); line-height: 1.4; }
  .mhead { padding-top: 0; border-bottom-color: var(--ink); }
  .ids { display: flex; flex-wrap: wrap; gap: 6px; }
  .idchip { font: 12px var(--mono); border: 1px solid var(--line); border-radius: 6px; padding: 2px 8px; text-decoration: none; align-self: center; }
  .idchip:hover { border-color: var(--ink); color: var(--ink); }

  .ev { margin-top: 32px; }
  .ev-id { font: 500 clamp(28px, 4vw, 44px) var(--mono); color: var(--amber-ink); }
  .ev-title { margin-top: 8px; max-width: 22em; font-size: clamp(24px, 3vw, 38px); line-height: 1.15; font-weight: 500; letter-spacing: -0.02em; text-wrap: balance; }
  .ev-meta { margin-top: 16px; }
  .ev-rel { margin-top: 20px; max-width: 40em; font-size: 18px; line-height: 1.5; color: var(--muted); }
  .ev-rel strong { color: var(--ink); font-weight: 600; }
  .ev-pdo { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px 24px; }
  .ev-pdo p:not(.mono-label) { font-size: 15px; line-height: 1.5; }
  .ev-cta { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }

  .plan { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px 28px; margin-top: 32px; }
  .phase { padding-top: 12px; border-top: 2px solid var(--ink); }
  .phase h3 { margin-top: 6px; font-size: 22px; font-weight: 600; }
  .phase ul { list-style: none; padding: 0; margin-top: 12px; display: flex; flex-direction: column; gap: 10px; font-size: 16px; line-height: 1.5; }
  .phase li::before { content: "– "; font-family: var(--mono); color: var(--muted); }

  .questions { list-style: none; padding: 0; margin-top: 16px; }
