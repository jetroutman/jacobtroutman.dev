---
import Base from '../../layouts/Base.astro';
import { threads, allNotes, noteHref } from '../../lib/notes';
import InkHud from '../../components/InkHud.astro';
import InkLayer from '../../components/InkLayer.astro';
import '../../styles/pages/notes.css';

import { W, H, pos, placed, edges, arcs, related, books } from '../../lib/idea-map';
---
<Base page="notes" title="Notes · Jacob Troutman" description="My Zettelkasten: permanent notes in my own words, grown into threads of ideas.">
  <div class="intro">
    <p class="mono-meta"><a href="/" data-back>← Decision log</a> / Notes</p>
    <h1 class="h1">Idea map</h1>
    <p class="desc">My Zettelkasten. Every dot is a permanent note in my own words; each cluster grows from one question I keep coming back to. Dashed lines are ideas that connect across threads.</p>
    <p class="mono-meta stats">{allNotes.length} notes · {threads.length} threads · {related.size} connections · drawn from {books} books in my <a href="/library/">library</a> · newest first in the <a href="/journal/">journal</a></p>
  </div>

  {allNotes.length === 0 ? <p class="empty">The notes sync from Notion on the next build.</p> : (
    <>
      <figure class="map">
        <svg viewBox={`-10 -10 ${W + 20} ${H + 20}`} role="img" aria-label="Map of my notes, grouped by thread">
          <g class="edges">{edges.map((e) => <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />)}</g>
          <g class="arcs">{arcs.map((d) => <path d={d} />)}</g>
          {placed.map((c) => (
            <g class="cluster">
              {c.t.notes.map((n) => {
                const p = n.id === 'loose' ? { x: c.cx, y: c.cy } : pos.get(n.id)!;
                const hub = n.depth === 0;
                return (
                  <a href={n.id === 'loose' ? `/notes/${c.t.slug}/` : noteHref(n)} class:list={['node', { hub }]} data-note={n.id === 'loose' ? undefined : n.id}>
                    <title>{n.fid ? `${n.fid} ${n.label}` : n.label}</title>
                    <circle cx={p.x} cy={p.y} r={hub ? 9 : n.depth === 1 ? 5.5 : 4} />
                  </a>
                );
              })}
              <text x={c.cx} y={c.cy - 16} class="hub-label" text-anchor="middle">{c.t.root.fid ? `${c.t.root.fid} · ` : ''}{c.t.root.label.length > 34 ? `${c.t.root.label.slice(0, 33)}…` : c.t.root.label}</text>
            </g>
          ))}
        </svg>
        <figcaption class="mono-meta">Hover a dot for its title; click to read it. Big dots start a thread.</figcaption>
      </figure>

      <section class="mine" data-mine hidden aria-labelledby="mine-h">
        <div class="mine-head"><h2 id="mine-h" class="mono-label">Notes you've opened</h2><span class="mono-meta" data-mine-n></span></div>
        <ol class="mine-list" data-mine-list></ol>
      </section>
      <div class="thread-tools"><button type="button" class="thread-filter" data-thread-filter aria-pressed="false" hidden>Threads with notes I've opened</button></div>
      <ul class="threads">
        {threads.map((t) => (
          <li data-thread-notes={t.notes.filter((n) => n.id !== 'loose').map((n) => n.id).join('|')}><a href={`/notes/${t.slug}/`}>
            <span class="mono-meta">{t.root.fid ? `Thread ${t.root.fid}` : 'Thread'} · {t.notes.length - (t.slug === 'loose-notes' ? 1 : 0)} notes<span class="opened-n" data-opened-n></span></span>
            <span class="t-title">{t.root.label}</span>
            {t.tags.length > 0 && <span class="mono-meta tags">{t.tags.slice(0, 4).join(' · ')}</span>}
          </a></li>
        ))}
      </ul>
    </>
  )}
  <InkHud variant="float" /><InkLayer />
  <script type="application/json" data-note-index set:html={JSON.stringify(Object.fromEntries(allNotes.map((n) => [n.id, { t: n.fid ? `${n.fid} ${n.label}` : n.label, h: noteHref(n) }])))} />
</Base>

<script>
  import { fromCompany } from '../../scripts/from-company';
  import { readInk, type InkState } from '../../scripts/ink';
  fromCompany('jt-notes');
  // What you've opened with ink: amber dots, a count per thread, a filter, and a list, most recent first.
  const index = JSON.parse(document.querySelector('[data-note-index]')?.textContent || '{}') as Record<string, { t: string; h: string }>;
  const mine = document.querySelector<HTMLElement>('[data-mine]'), list = document.querySelector<HTMLElement>('[data-mine-list]');
  const mineN = document.querySelector<HTMLElement>('[data-mine-n]'), filter = document.querySelector<HTMLButtonElement>('[data-thread-filter]');
  let only = false;
  const show = (st: InkState) => {
    const opened = new Map<string, number>();
    for (const k of st.unlocked) { const m = k.match(/^(.+):note$/); if (m && index[m[1]]) opened.set(m[1], st.at[k] || 0); }
    for (const d of document.querySelectorAll<SVGAElement>('[data-note]')) d.classList.toggle('opened', opened.has(d.dataset.note!));
    for (const li of document.querySelectorAll<HTMLElement>('[data-thread-notes]')) {
      const n = li.dataset.threadNotes!.split('|').filter((id) => opened.has(id)).length;
      li.querySelector('[data-opened-n]')!.textContent = n ? ` · ${n} opened` : '';
      li.hidden = only && n === 0;
    }
    if (!mine || !list || !mineN || !filter) return;
    mine.hidden = opened.size === 0; filter.hidden = opened.size === 0;
    mineN.textContent = `${opened.size}`;
    list.replaceChildren(...[...opened].sort((a, b) => b[1] - a[1]).map(([id, at]) => {
      const li = document.createElement('li'), a = document.createElement('a'), when = document.createElement('span');
      a.href = index[id].h; a.textContent = index[id].t;
      when.className = 'mono-meta'; when.textContent = at ? new Date(at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
      li.append(a, when); return li;
    }));
  };
  filter?.addEventListener('click', () => { only = !only; filter.setAttribute('aria-pressed', String(only)); show(readInk()); });
  document.addEventListener('ink:change', (e) => show((e as CustomEvent).detail));
  show(readInk());
</script>
