---
import Base from '../../layouts/Base.astro';
import { threads, allNotes, noteById, noteHref } from '../../lib/notes';

// Idea map: each thread is a radial cluster around its starting question; branches fan out by depth.
// Dashed arcs are "Related" links, often between threads. Laid out at build time, no client library.
const RING = 30, PAD = 46;
type P = { x: number; y: number };
const pos = new Map<string, P>();
const clusters = threads.map((t) => {
  const leaves = (id: string): number => { const n = t.notes.find((x) => x.id === id)!; return n.children.length ? n.children.reduce((s, c) => s + leaves(c), 0) : 1; };
  const maxDepth = Math.max(...t.notes.map((n) => n.depth));
  // Spread rings out when a thread has many tips, so dots don't pile up (~11 units of arc per tip).
  const ring = Math.max(RING, (leaves(t.root.id) * 11) / (2 * Math.PI * Math.max(maxDepth, 1)));
  const local = new Map<string, P>();
  const place = (id: string, a0: number, a1: number, depth: number) => {
    const n = t.notes.find((x) => x.id === id)!;
    const mid = (a0 + a1) / 2, r = depth * ring;
    local.set(id, { x: Math.cos(mid) * r, y: Math.sin(mid) * r });
    let at = a0;
    for (const c of n.children) { const span = ((a1 - a0) * leaves(c)) / leaves(id); place(c, at, at + span, depth + 1); at += span; }
  };
  place(t.root.id, -Math.PI / 2, (3 * Math.PI) / 2, 0);
  return { t, local, radius: Math.max(maxDepth, 1) * ring + PAD };
});
// Pack clusters into rows, biggest first; each row is centred horizontally and its clusters vertically.
const W = 1100;
const rows: (typeof clusters)[] = [[]]; let rowW = 0;
for (const c of [...clusters].sort((a, b) => b.radius - a.radius)) {
  if (rowW + c.radius * 2 > W && rows.at(-1)!.length) { rows.push([]); rowW = 0; }
  rows.at(-1)!.push(c); rowW += c.radius * 2;
}
let y = 0;
const placed = rows.flatMap((row) => {
  const h = Math.max(...row.map((c) => c.radius * 2));
  let x = (W - row.reduce((s, c) => s + c.radius * 2, 0)) / 2;
  const out = row.map((c) => {
    const cx = x + c.radius, cy = y + h / 2; x += c.radius * 2;
    for (const [id, p] of c.local) pos.set(id, { x: cx + p.x, y: cy + p.y });
    return { ...c, cx, cy };
  });
  y += h; return out;
});
const H = y;
const edges = allNotes.filter((n) => n.parent && pos.has(n.parent)).map((n) => ({ a: pos.get(n.parent!)!, b: pos.get(n.id)! }))
  .concat(placed.filter((c) => c.t.slug === 'loose-notes').flatMap((c) => c.t.notes.slice(1).map((n) => ({ a: { x: c.cx, y: c.cy }, b: pos.get(n.id)! }))));
const related = new Set<string>();
const arcs = allNotes.flatMap((n) => n.related.filter((r) => noteById.has(r)).map((r) => {
  const key = [n.id, r].sort().join('|'); if (related.has(key)) return null; related.add(key);
  const a = pos.get(n.id)!, b = pos.get(r)!; const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2 - Math.hypot(b.x - a.x, b.y - a.y) * 0.25;
  return `M${a.x.toFixed(1)},${a.y.toFixed(1)} Q${mx.toFixed(1)},${my.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`;
}).filter(Boolean)) as string[];
const books = new Set(allNotes.flatMap((n) => n.books.map((b) => b.href))).size;
---
<Base title="Notes · Jacob Troutman" description="My Zettelkasten: permanent notes in my own words, grown into threads of ideas.">
  <div class="intro">
    <p class="mono-meta"><a href="/" data-back>← Decision log</a> / Notes</p>
    <h1 class="h1">Idea map</h1>
    <p class="desc">My Zettelkasten. Every dot is a permanent note in my own words; each cluster grows from one question I keep coming back to. Dashed lines are ideas that connect across threads.</p>
    <p class="mono-meta stats">{allNotes.length} notes · {threads.length} threads · {related.size} connections · drawn from {books} books in my <a href="/library/">library</a> · newest first in the <a href="/journal/">journal</a></p>
  </div>

  {allNotes.length === 0 ? <p class="empty">The notes sync from Notion on the next build.</p> : (
    <>
      <figure class="map">
        <svg viewBox={`-10 -10 ${W + 20} ${H + 20}`} role="img" aria-label="Map of my notes, grouped by thread">
          <g class="edges">{edges.map((e) => <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />)}</g>
          <g class="arcs">{arcs.map((d) => <path d={d} />)}</g>
          {placed.map((c) => (
            <g class="cluster">
              {c.t.notes.map((n) => {
                const p = n.id === 'loose' ? { x: c.cx, y: c.cy } : pos.get(n.id)!;
                const hub = n.depth === 0;
                return (
                  <a href={n.id === 'loose' ? `/notes/${c.t.slug}/` : noteHref(n)} class:list={['node', { hub }]}>
                    <title>{n.fid ? `${n.fid} ${n.label}` : n.label}</title>
                    <circle cx={p.x} cy={p.y} r={hub ? 9 : n.depth === 1 ? 5.5 : 4} />
                  </a>
                );
              })}
              <text x={c.cx} y={c.cy - 16} class="hub-label" text-anchor="middle">{c.t.root.fid ? `${c.t.root.fid} · ` : ''}{c.t.root.label.length > 34 ? `${c.t.root.label.slice(0, 33)}…` : c.t.root.label}</text>
            </g>
          ))}
        </svg>
        <figcaption class="mono-meta">Hover a dot for its title; click to read it. Big dots start a thread.</figcaption>
      </figure>

      <ul class="threads">
        {threads.map((t) => (
          <li><a href={`/notes/${t.slug}/`}>
            <span class="mono-meta">{t.root.fid ? `Thread ${t.root.fid}` : 'Thread'} · {t.notes.length - (t.slug === 'loose-notes' ? 1 : 0)} notes</span>
            <span class="t-title">{t.root.label}</span>
            {t.tags.length > 0 && <span class="mono-meta tags">{t.tags.slice(0, 4).join(' · ')}</span>}
          </a></li>
        ))}
      </ul>
    </>
  )}
</Base>

<script>
  import { fromCompany } from '../../scripts/from-company';
  fromCompany('jt-notes');
</script>

<style>
  .intro { padding-top: clamp(28px, 5vw, 64px); max-width: 760px; }
  .intro > p a { text-decoration: none; }
  h1 { margin-top: 18px; font-size: clamp(34px, 4.4vw, 52px); line-height: 1.02; }
  .desc { margin-top: 12px; font-size: 17px; line-height: 1.5; color: var(--muted); }
  .stats { margin-top: 14px; }
  .empty { margin-top: 32px; color: var(--muted); }
  .map { margin: 28px 0 0; padding: 12px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .map svg { width: 100%; height: auto; display: block; }
  .edges line { stroke: var(--line); stroke-width: 1.4; }
  .arcs path { fill: none; stroke: var(--amber); stroke-width: 1.2; stroke-dasharray: 4 4; opacity: 0.7; }
  .node circle { fill: var(--muted); transition: r 0.15s, fill 0.15s; }
  .node.hub circle { fill: var(--ink); }
  .node:hover circle, .node:focus-visible circle { fill: var(--amber); r: 8; }
  .hub-label { font: 600 11px var(--sans); fill: var(--ink); paint-order: stroke; stroke: var(--surface); stroke-width: 4px; }
  figcaption { margin-top: 8px; padding: 0 4px; }
  .threads { list-style: none; padding: 0; margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .threads a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); text-decoration: none; }
  .threads a:hover { border-color: var(--ink); }
  .t-title { font-size: 17px; font-weight: 600; line-height: 1.3; }
</style>
