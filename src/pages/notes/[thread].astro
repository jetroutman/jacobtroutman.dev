---
import Base from '../../layouts/Base.astro';
import { threads, noteById, noteHref, anchor, type Note, type Thread, type Block } from '../../lib/notes';
import InkSeal from '../../components/InkSeal.astro';
import InkHud from '../../components/InkHud.astro';
import InkLayer from '../../components/InkLayer.astro';
import { INK, refById, wordCount } from '../../lib/posts';
import '../../styles/pages/notes-thread.css';

export function getStaticPaths() {
  return threads.map((t) => ({ params: { thread: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Thread };
const name = (n: Note) => (n.fid ? `${n.fid} ${n.label}` : n.label);
const link = (id: string) => noteById.get(id);
// Group consecutive list items so they render as real lists.
type Chunk = { k: 'h' | 'p' | 'q'; t: string } | { k: 'ul' | 'ol'; items: Block[] };
const chunks = (body: Block[]): Chunk[] => {
  const out: Chunk[] = [];
  for (const b of body) {
    const lk = b.k === 'li' ? 'ul' : b.k === 'ol' ? 'ol' : null;
    const last = out.at(-1);
    if (lk) { if (last && last.k === lk) last.items.push(b); else out.push({ k: lk, items: [b] }); }
    else out.push({ k: b.k as 'h' | 'p' | 'q', t: b.t });
  }
  return out;
};
const notes = t.notes.filter((n) => n.id !== 'loose');
const words = (n: Note) => wordCount(...n.body.map((b) => b.t));
const srcs = (n: Note) => n.sources.filter((id) => refById.has(id)).map((id) => ({ id, ...refById.get(id)! }));
const first = t.slug === 'loose-notes' ? notes[0] : t.root;
---
<Base page="notes-thread" title={`${t.root.label} · Notes · Jacob Troutman`} description={`A thread from my Zettelkasten: ${t.root.label}`}>
  <div class="head">
    <p class="mono-meta crumbs"><a href="/notes/">← Idea map</a> / {t.root.fid ? `Thread ${t.root.fid}` : 'Thread'}<a class="back" href="/" data-back hidden>← Back to your page</a></p>
    <h1 class="h1">{t.root.label}</h1>
    <p class="mono-meta">{notes.length} notes{t.tags.length ? ` · ${t.tags.join(' · ')}` : ''}</p>
  </div>

  <div class="layout">
    <nav class="tree" aria-label="Notes in this thread">
      <div class="tree-tools"><span class="mono-meta" data-open-count></span><button type="button" class="tree-filter" data-tree-filter aria-pressed="false">Opened only</button></div>
      <ul>
        {t.notes.map((n) => (
          <li style={`--d:${n.depth}`} class:list={{ root: n.depth === 0 }}>
            {n.id === 'loose'
              ? <span class="tree-root">{n.label}</span>
              : <a href={`#${anchor(n)}`} data-pick={anchor(n)} data-tree-note={n.id} data-free={n.depth === 0 || n.body.length === 0 ? '1' : undefined}><span class="fid">{n.fid || '•'}</span><span class="lbl">{n.label}</span></a>}
          </li>
        ))}
      </ul>
    </nav>

    <div class="reader" data-reader>
      {notes.map((n) => (
        <article id={anchor(n)} class="note" data-note hidden={n !== first}>
          <p class="mono-meta">{n.fid ? `${n.fid} · ` : ''}{n.depth === 0 ? 'Starting question' : n.depth === 1 ? 'Branch' : 'Sub-branch'}{n.edited ? ` · edited ${n.edited}` : ''}</p>
          <h2>{n.label}</h2>
          {n.tags.length > 0 && <p class="tags">{n.tags.map((g) => <span class="tag">{g}</span>)}</p>}
          {n.parent && link(n.parent) && (
            <p class="mono-meta parent">Grew from <a href={noteHref(link(n.parent)!)} data-trail={n.parent} data-pick={link(n.parent)!.thread === t.slug ? anchor(link(n.parent)!) : undefined}>{name(link(n.parent)!)}</a></p>
          )}
          {n.body.length === 0
            ? <div class="body"><p class="muted">Just a heading for now; the thinking lives in the branches.</p></div>
            : n.depth === 0
              ? <div class="body" data-read={`${n.id}:note:read`} data-words={words(n)}>{chunks(n.body).map((c) => c.k === 'h' ? <h3>{c.t}</h3> : c.k === 'q' ? <blockquote>{c.t}</blockquote> : c.k === 'p' ? <p>{c.t}</p> : c.k === 'ul' ? <ul>{c.items.map((i) => <li style={`--d:${i.d}`}>{i.t}</li>)}</ul> : <ol>{c.items.map((i) => <li style={`--d:${i.d}`}>{i.t}</li>)}</ol>)}</div>
              : <InkSeal id={`${n.id}:note`} cost={INK.noteCost} label="My note" words={words(n)}>
                  <div class="body">{chunks(n.body).map((c) => c.k === 'h' ? <h3>{c.t}</h3> : c.k === 'q' ? <blockquote>{c.t}</blockquote> : c.k === 'p' ? <p>{c.t}</p> : c.k === 'ul' ? <ul>{c.items.map((i) => <li style={`--d:${i.d}`}>{i.t}</li>)}</ul> : <ol>{c.items.map((i) => <li style={`--d:${i.d}`}>{i.t}</li>)}</ol>)}</div>
                </InkSeal>}
          {srcs(n).length > 0 && (
            <InkSeal id={`${n.id}:src`} cost={INK.sourceCost} label={`Where this came from · ${[...new Set(srcs(n).map((x) => x.book))].join(', ')}`} after={n.depth > 0 && n.body.length ? `${n.id}:note` : undefined} also={srcs(n).map((x) => `ref:${x.id}`)} words={wordCount(...srcs(n).map((x) => `${x.interpretation || ''} ${x.quote || ''}`))}>
              {srcs(n).map((x) => (
                <div class="src">
                  <p class="src-title"><a href={x.bookHref} tabindex="-1">{x.title}</a></p>
                  {x.interpretation && <p>{x.interpretation}</p>}
                  {x.quote && <blockquote>{x.quote}</blockquote>}
                </div>
              ))}
            </InkSeal>
          )}
          {n.books.length > 0 && (
            <div class="rel"><p class="mono-label">Grew out of</p>{n.books.map((b) => <a class="chip book" href={b.href}>{b.title}</a>)}</div>
          )}
          {n.children.length > 0 && (
            <div class="rel"><p class="mono-label">Branches</p>{n.children.map((c) => link(c) && <a class="chip" href={`#${anchor(link(c)!)}`} data-pick={anchor(link(c)!)} data-trail={c}>{name(link(c)!)}</a>)}</div>
          )}
          {n.related.some(link) && (
            <div class="rel"><p class="mono-label">Connects to</p>{n.related.map((r) => link(r) && <a class="chip arc" href={noteHref(link(r)!)} data-trail={r} data-pick={link(r)!.thread === t.slug ? anchor(link(r)!) : undefined}>{name(link(r)!)}{link(r)!.thread !== t.slug && <span class="other"> · other thread</span>}</a>)}</div>
          )}
          {n.next.some((x) => link(x) && !n.children.includes(x)) && (
            <div class="rel"><p class="mono-label">Next</p>{n.next.map((x) => link(x) && !n.children.includes(x) && <a class="chip" href={noteHref(link(x)!)} data-trail={x}>{name(link(x)!)}</a>)}</div>
          )}
        </article>
      ))}
    </div>
  </div>
  <InkHud variant="float" /><InkLayer />
</Base>

<script>
  import { fromCompany } from '../../scripts/from-company';
  import { readInk } from '../../scripts/ink';
  fromCompany('jt-notes');
  // One note at a time in the reader; the tree and chips pick it, and the URL hash keeps it shareable.
  const arts = [...document.querySelectorAll<HTMLElement>('[data-note]')];
  const picks = [...document.querySelectorAll<HTMLAnchorElement>('[data-pick]')];
  const reader = document.querySelector<HTMLElement>('[data-reader]')!;
  function show(id: string, scroll: boolean) {
    const art = arts.find((a) => a.id === id); if (!art) return;
    for (const a of arts) a.hidden = a !== art;
    for (const p of picks) p.classList.toggle('on', p.dataset.pick === id && !!p.closest('.tree'));
    if (scroll && matchMedia('(max-width: 899px)').matches) reader.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  for (const p of picks) p.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', `#${p.dataset.pick}`); show(p.dataset.pick!, true); });
  const fromHash = () => { if (location.hash) show(location.hash.slice(1), false); else show(arts.find((a) => !a.hidden)?.id || '', false); };
  addEventListener('hashchange', fromHash); fromHash();

  // Which notes you've opened with ink: marked in the tree, countable, and filterable.
  const treeLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-tree-note]')];
  const filterBtn = document.querySelector<HTMLButtonElement>('[data-tree-filter]')!;
  const countEl = document.querySelector<HTMLElement>('[data-open-count]')!;
  let onlyOpen = false, unlocked: string[] = readInk().unlocked;
  const mark = () => {
    let open = 0, locked = 0;
    for (const a of treeLinks) {
      const free = a.dataset.free === '1', isOpen = unlocked.includes(`${a.dataset.treeNote}:note`);
      a.dataset.state = free ? 'free' : isOpen ? 'open' : 'locked';
      if (isOpen) open++; if (!free) locked++;
      a.closest('li')!.hidden = onlyOpen && !isOpen && !free;
    }
    countEl.textContent = locked ? `${open} of ${locked} opened` : '';
    filterBtn.hidden = locked === 0;
  };
  document.addEventListener('ink:change', (e) => { unlocked = (e as CustomEvent).detail.unlocked; mark(); });
  filterBtn.addEventListener('click', () => { onlyOpen = !onlyOpen; filterBtn.setAttribute('aria-pressed', String(onlyOpen)); mark(); });
  mark();
</script>
