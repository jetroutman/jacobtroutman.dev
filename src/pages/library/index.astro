---
import Base from '../../layouts/Base.astro';
import { books as allBooks, favorite, rankedCount, type LibBook } from '../../lib/library';
import '../../styles/pages/library.css';
const books = allBooks as LibBook[];

const counts = new Map<string, number>();
for (const b of books) for (const t of b.tags) counts.set(t, (counts.get(t) || 0) + 1);
const topTags = [...counts].filter(([, n]) => n >= 3).sort((a, b) => b[1] - a[1]).slice(0, 14).map(([t]) => t);
const fav = books.filter(favorite).length;
---
<Base page="library" title="Library · Jacob Troutman" description="Books I've read and written up, straight from my Notion catalog.">
  <div class="intro">
    <p class="mono-meta"><a href="/" data-back>← Decision log</a> / Library</p>
    <h1 class="h1">Library</h1>
    <p class="desc">Books I've read and written up, straight from my Notion catalog. Ranked by my own rating; the ones that changed how I work are marked. Some come with my notes, which grow into my <a href="/notes/">idea map</a>.</p>
    <p class="mono-meta stats">{books.length} books · {fav} favorites · {books.filter((b) => b.fiction).length} fiction</p>
  </div>

  <div class="filters" role="group" aria-label="Filter books">
    <div class="seg" role="group" aria-label="Kind">
      <button type="button" data-kind="all" aria-pressed="true">All</button>
      <button type="button" data-kind="non" aria-pressed="false">Non-fiction</button>
      <button type="button" data-kind="fic" aria-pressed="false">Fiction</button>
      <button type="button" data-kind="fav" aria-pressed="false">Favorites</button>
    </div>
    <div class="tags">
      {topTags.map((t) => <button type="button" class="tag" data-tag={t} aria-pressed="false">{t}</button>)}
    </div>
  </div>

  <ul class="shelf" data-shelf>
    {books.map((b) => (
      <li class="book" data-fic={b.fiction ? '1' : '0'} data-fav={favorite(b) ? '1' : '0'} data-tags={b.tags.join('|')}>
        <div class="top">
          <span class="rank" title={b.rank ? `Ranked #${b.rank} of ${rankedCount} by my own rating` : 'Not ranked yet'}>{b.rank ? `#${b.rank}` : '—'}</span>
          {favorite(b) && <span class="pill">{b.rating}</span>}
          {b.finishedLabel && <span class="mono-meta">{b.finishedLabel}</span>}
        </div>
        <h2 class="title">{b.hasPage ? <a href={`/library/${b.slug}/`}>{b.short}</a> : b.short}</h2>
        {b.subtitle && <p class="sub">{b.subtitle}</p>}
        {b.author && <p class="author">{b.author}</p>}
        {b.tags.length > 0 && <p class="mono-meta btags">{b.tags.slice(0, 4).join(' · ')}</p>}
        <div class="foot">
          {b.notes ? <span class="mono-meta">{b.notes} notes</span> : null}
          {b.hasPage && <a class="more" href={`/library/${b.slug}/`}>{b.review || b.impressions ? 'My take →' : 'My notes →'}</a>}
        </div>
      </li>
    ))}
  </ul>
  <p class="mono-meta empty" data-empty hidden>Nothing matches that filter.</p>
</Base>

<script>
  import { fromCompany } from '../../scripts/from-company';
  fromCompany('jt-lib');
  const items = [...document.querySelectorAll<HTMLElement>('.book')];
  const kinds = [...document.querySelectorAll<HTMLButtonElement>('[data-kind]')];
  const tags = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let kind = 'all', tag: string | null = null;
  function apply() {
    let shown = 0;
    for (const el of items) {
      const okKind = kind === 'all' || (kind === 'fic' ? el.dataset.fic === '1' : kind === 'non' ? el.dataset.fic === '0' : el.dataset.fav === '1');
      const okTag = !tag || el.dataset.tags!.split('|').includes(tag);
      el.hidden = !(okKind && okTag); if (!el.hidden) shown++;
    }
    empty.hidden = shown > 0;
    kinds.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === kind)));
    tags.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
  }
  kinds.forEach((b) => b.addEventListener('click', () => { kind = b.dataset.kind!; apply(); }));
  tags.forEach((b) => b.addEventListener('click', () => { tag = tag === b.dataset.tag ? null : b.dataset.tag!; apply(); }));
</script>
