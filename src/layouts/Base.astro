---
import { site } from '../site';
import '../styles/layout.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

interface Props {
  /** Names the page's stylesheet scope: body gets class pg-<page> (see src/styles/pages/). */
  page?: string;
  title: string;
  description?: string;
  noindex?: boolean;
  /** Replaces the footer's right-hand note (used on company pages). */
  footerNote?: string;
}
const { title, description = site.description, noindex = false, footerNote, page } = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('jt-theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
          document.documentElement.style.colorScheme = t;
        }
      } catch {}
    </script>
  </head>
  <body class={page ? `pg-${page}` : undefined}>
    <div class="wrap">
      <header class="site-header c">
        <a class="name" href="/">{site.name}</a>
        <div class="header-right">
          <nav class="site-nav" aria-label="Site">
            <a href="/pocket-log/" data-from-link>Pocket Log</a>
            <a href="/posts/" data-from-link>Posts</a>
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle>Dark mode</button>
        </div>
      </header>

      <slot />

      <footer class="site-footer c" class:list={{ note: !!footerNote }}>
        {footerNote && <span>{footerNote}</span>}
        <nav aria-label="Contact">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={site.github}>GitHub</a>
          <a href={site.resume}>Résumé (PDF)</a>
        </nav>
        {!footerNote && <span>Updated {site.updated}</span>}
      </footer>
    </div>

    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        const root = document.documentElement;
        const current = () =>
          root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const label = () => { btn.textContent = current() === 'dark' ? 'Light mode' : 'Dark mode'; };
        label();
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          root.style.colorScheme = next;
          try { localStorage.setItem('jt-theme', next); } catch {}
          label();
        });
      })();
    </script>
  </body>
</html>
