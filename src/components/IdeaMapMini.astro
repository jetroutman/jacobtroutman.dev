---
// A small, decorative copy of the idea map (/notes/), used to advertise it. Cropped to fill its box.
import { W, H, pos, placed, edges, arcs } from '../lib/idea-map';
import '../styles/components/idea-map-mini.css';
const ok = Number.isFinite(H) && H > 0;
---
{ok && (
  <svg class="c c-idea-map-mini" viewBox={`-10 -10 ${W + 20} ${H + 20}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
    <g class="edges">{edges.map((e) => <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />)}</g>
    <g class="arcs">{arcs.map((d) => <path d={d} />)}</g>
    <g class="dots">
      {placed.flatMap((c) => c.t.notes.map((n) => {
        const p = n.id === 'loose' ? { x: c.cx, y: c.cy } : pos.get(n.id)!;
        return <circle class:list={{ hub: n.depth === 0 }} cx={p.x} cy={p.y} r={n.depth === 0 ? 11 : n.depth === 1 ? 7 : 5} />;
      }))}
    </g>
  </svg>
)}
