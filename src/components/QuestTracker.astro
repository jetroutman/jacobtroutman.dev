---
/**
 * Company-page tour (gamification). Octalysis drives used:
 * Development & Accomplishment (visible progress), Curiosity (a locked bonus),
 * Ownership (progress is saved per page). Player journey: Discovery = summary,
 * Onboarding = evidence, Scaffolding = 90 days, Endgame = questions + bonus.
 *
 * Progressive enhancement: without JS every section and the bonus are simply shown.
 * Progress lives in localStorage only; nothing leaves the reader's browser.
 */
interface Props { slug: string; steps: { id: string; label: string }[]; hasBonus: boolean }
const { slug, steps, hasBonus } = Astro.props;
---
<div class="quest" data-quest={slug} data-steps={JSON.stringify(steps.map((s) => s.id))} hidden>
  <div class="quest-head">
    <span class="mono-label">Your tour</span>
    <span class="mono-meta" data-quest-count aria-live="polite">0 of {steps.length}</span>
  </div>
  <div class="bar" aria-hidden="true"><span data-quest-bar></span></div>
  <ol>
    {steps.map((s) => (
      <li data-step={s.id}><a href={`#${s.id}`}><span class="tick" aria-hidden="true"></span>{s.label}</a></li>
    ))}
    {hasBonus && <li class="bonus-step" data-step-bonus><span class="tick" aria-hidden="true"></span><span data-bonus-label>Finish the tour to unlock a note</span></li>}
  </ol>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-quest]')) {
    const slug = el.dataset.quest!;
    const ids: string[] = JSON.parse(el.dataset.steps!);
    const key = `jt-quest-${slug}`;
    const bonus = document.querySelector<HTMLElement>('[data-bonus]');
    let seen = new Set<string>();
    try { seen = new Set(JSON.parse(localStorage.getItem(key) || '[]')); } catch {}

    el.hidden = false;
    if (bonus && seen.size < ids.length) bonus.hidden = true;

    const render = () => {
      const n = ids.filter((id) => seen.has(id)).length;
      el.querySelector('[data-quest-count]')!.textContent = `${n} of ${ids.length}`;
      el.querySelector<HTMLElement>('[data-quest-bar]')!.style.width = `${(n / ids.length) * 100}%`;
      for (const id of ids) el.querySelector(`[data-step="${id}"]`)?.classList.toggle('done', seen.has(id));
      const done = n === ids.length;
      el.querySelector('[data-step-bonus]')?.classList.toggle('done', done);
      const label = el.querySelector('[data-bonus-label]');
      if (label) label.textContent = done ? 'Note unlocked ↓' : 'Finish the tour to unlock a note';
      if (bonus && done && bonus.hidden) { bonus.hidden = false; bonus.classList.add('fresh'); }
    };

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !seen.has(e.target.id)) {
          seen.add(e.target.id);
          try { localStorage.setItem(key, JSON.stringify([...seen])); } catch {}
          render();
        }
      }
    }, { threshold: 0.35 });
    for (const id of ids) { const s = document.getElementById(id); if (s) io.observe(s); }
    render();
  }
</script>

<style>
  .quest { margin-top: 28px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .quest-head { display: flex; justify-content: space-between; align-items: baseline; }
  .bar { margin-top: 10px; height: 4px; border-radius: 999px; background: var(--hover); overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--amber); transition: width 200ms ease-out; }
  ol { list-style: none; padding: 0; margin-top: 10px; display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
  li a, .bonus-step { display: flex; align-items: center; gap: 10px; padding: 6px 0; text-decoration: none; color: var(--muted); }
  li.done a, li.done { color: var(--ink); }
  .tick { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--line); flex: none; display: grid; place-items: center; font: 9px var(--mono); }
  li.done .tick { border-color: var(--amber); background: var(--amber-tint); color: var(--amber-ink); }
  li.done .tick::after { content: "✓"; }
  .bonus-step { font-family: var(--mono); font-size: 12px; }
  @media (prefers-reduced-motion: reduce) { .bar span { transition: none; } }
</style>
