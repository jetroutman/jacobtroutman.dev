---
// Everything ink needs on a page besides the counter: config, toasts, the gift modal, flying drops.
// Pages that use it: posts (data-post on the deck) and book pages (data-ink-page).
import { INK } from '../lib/posts';
import '../styles/components/ink-layer.css';
---
<div class="ink-toasts" data-ink-toasts aria-live="polite"></div>
<script type="application/json" data-ink-config set:html={JSON.stringify(INK)} />
<script>
  import { initInk } from '../scripts/ink';
  initInk();
</script>
