---
import '../styles/components/dev-todo.css';
// Shows unconfirmed claims in dev and PR previews. Never rendered in a production build.
interface Props { items: string[] }
const { items } = Astro.props;
const show = (import.meta.env.DEV || import.meta.env.PUBLIC_DRAFTS === 'true') && items.length > 0;
---
{show && (
  <div class="todo c c-dev-todo"><p class="mono-label">Before launch (preview only)</p><ul>{items.map((t) => <li>{t}</li>)}</ul></div>
)}
