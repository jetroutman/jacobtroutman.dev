---
// One post, played as readers see it: free claims earn ink, sealed layers cost ink.
// Used by /posts/<slug>/ (Published) and /admin/<slug>/ (any status, locked to the admin role).
import { INK, inline, type Post } from '../lib/posts';
interface Props { post: Post; admin?: boolean }
const { post, admin = false } = Astro.props;
const drop = 'M12 2.5C12 2.5 5.2 10.4 5.2 15.2a6.8 6.8 0 0 0 13.6 0C18.8 10.4 12 2.5 12 2.5Z';
const fmt = (d: string | null) => (d ? new Date(`${d.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : null);
---
<article class="post" data-post={post.id} data-admin={admin ? '1' : undefined}>
  <header class="p-head">
    <p class="mono-meta crumbs">{admin ? <a href="/admin/">← Drafts</a> : <a href="/" data-back>← Decision log</a>} / {admin ? post.status : 'Posts'}</p>
    <h1 class="p-title">{post.title}</h1>
    {post.hook && <p class="p-hook">{post.hook}</p>}
    <p class="mono-meta p-meta">{fmt(post.published) || (admin ? `Edited ${fmt(post.edited)}` : '')} · {post.minutes} min · {post.cardCount} cards{post.bookLinks.length > 0 && <> · from {post.bookLinks.map((b, i) => <>{i > 0 && ', '}<a href={b.href}><em>{b.title}</em></a></>)}</>}</p>
  </header>

  <div class="p-body">
    {post.body.map((b) => b.k === 'card' ? (
      b.card ? (
        <section class="card" data-card={b.card.id} aria-label={`Card ${b.card.fid || ''}: ${b.card.label}`}>
          <h3 class="c-title">{b.card.fid && <span class="fid">{b.card.fid}</span>}{b.card.label}</h3>
          {b.card.body.map((t) => <p class="c-body">{t}</p>)}
          {b.card.sources.length > 0 && (
            <div class="layer" data-layer={`${b.card.id}:src`} data-cost={INK.sourceCost}>
              <p class="mono-label l-label">Where this came from · {b.card.sources.map((s) => s.book).filter((x, i, a) => a.indexOf(x) === i).join(', ')}</p>
              <div class="l-content" data-veil>
                {b.card.sources.map((s) => (
                  <div class="src">
                    <p class="src-title"><a href={s.bookHref} tabindex="-1">{s.title}</a></p>
                    {s.interpretation && <p>{s.interpretation}</p>}
                    {s.quote && <blockquote>{s.quote}</blockquote>}
                  </div>
                ))}
              </div>
              <span class="flood" aria-hidden="true"></span>
              <button type="button" class="seal" data-unseal><svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop}></path></svg><span data-seal-label>Unseal · {INK.sourceCost}</span></button>
            </div>
          )}
          {b.card.branches.length > 0 && (
            <div class="layer" data-layer={`${b.card.id}:br`} data-cost={INK.branchesCost}>
              <p class="mono-label l-label">Where it went · {b.card.branches.length} {b.card.branches.length === 1 ? 'idea' : 'ideas'}</p>
              <ul class="l-content br" data-veil>
                {b.card.branches.map((x) => <li><a href={x.href} tabindex="-1">{x.fid && <span class="fid">{x.fid}</span>}{x.label}</a></li>)}
              </ul>
              <span class="flood" aria-hidden="true"></span>
              <button type="button" class="seal" data-unseal><svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop}></path></svg><span data-seal-label>Unseal · {INK.branchesCost}</span></button>
            </div>
          )}
          <a class="c-link mono-meta" href={b.card.href}>Open in its thread →</a>
        </section>
      ) : admin ? <p class="missing mono-meta">Card {b.id.slice(0, 8)} isn't on the site (Private, or not synced yet).</p> : null
    ) : b.k === 'h' ? <h2 class="p-h2" set:html={inline(b.t)} />
      : b.k === 'q' ? <blockquote class="p-q" set:html={inline(b.t)} />
      : b.k === 'li' ? <p class="p-li" set:html={inline(b.t)} />
      : <p class="p-p" set:html={inline(b.t)} />)}
  </div>
  <div class="p-end" data-post-end>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop}></path></svg>
    <p>End of post · finishing it earns {INK.postFinished} ink</p>
  </div>
</article>

<aside class="hud" data-hud aria-label="Your ink">
  <span class="hud-pill" data-hud-pill>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop} class="hud-drop"></path><path d="M12 10.6V16.4" class="hud-nib"></path><circle cx="12" cy="9.4" r="1.25" class="hud-hole"></circle></svg>
    <span class="hud-n" data-wallet>0</span>
    <span class="hud-lv mono-meta" data-level>Elementary</span>
  </span>
  <span class="hud-gain" data-gain aria-live="polite"></span>
</aside>
<div class="ink-toasts" data-ink-toasts aria-live="polite"></div>
<script type="application/json" data-ink-config set:html={JSON.stringify(INK)} />

<script>
  import { initInk } from '../scripts/ink';
  initInk();
</script>

<style>
  .post { max-width: 680px; margin: 0 auto; padding: clamp(28px, 5vw, 64px) 0 40px; }
  .crumbs a, .p-meta a { text-decoration: none; }
  .crumbs a:hover, .p-meta a:hover { text-decoration: underline; }
  .p-title { margin-top: 18px; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
  .p-hook { margin-top: 14px; font-size: 19px; line-height: 1.5; color: var(--muted); }
  .p-meta { margin-top: 14px; }
  .p-body { margin-top: 36px; font-family: var(--reading); font-size: 18px; line-height: 1.65; }
  .p-p, .p-li, .p-q { margin-top: 18px; }
  .p-li { padding-left: 18px; position: relative; } .p-li::before { content: "–"; position: absolute; left: 0; color: var(--muted); }
  .p-q { padding-left: 16px; border-left: 2px solid var(--line); color: var(--muted); }
  .p-h2 { margin-top: 44px; font-family: var(--sans); font-size: 24px; line-height: 1.25; letter-spacing: -0.015em; }
  .missing { margin-top: 18px; padding: 10px 12px; border: 1px dashed var(--line); border-radius: 8px; }

  .card { margin: 26px 0; padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); font-family: var(--sans); font-size: 16px; line-height: 1.55; scroll-margin-top: 24px; transition: border-color .4s; }
  .card.reached { border-color: color-mix(in srgb, var(--amber) 45%, var(--line)); }
  .c-title { font-size: 19px; line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty; }
  .fid { font: 500 0.72em var(--mono); color: var(--amber-ink); margin-right: 9px; }
  .c-body { margin-top: 10px; }
  .c-link { display: inline-block; margin-top: 14px; text-decoration: none; }
  .c-link:hover { color: var(--ink); }

  .layer { position: relative; overflow: hidden; margin-top: 14px; padding: 14px 16px; border-radius: 10px; background: var(--hover); }
  .l-label { margin-bottom: 8px; }
  .l-content { font-size: 15px; line-height: 1.5; transition: filter .5s ease .35s, opacity .5s ease .35s; }
  .layer:not(.open) .l-content { filter: blur(5px); opacity: .5; user-select: none; pointer-events: none; min-height: 44px; }
  .src + .src { margin-top: 12px; }
  .src-title { font-weight: 600; } .src-title a { text-decoration: none; }
  .src blockquote { margin: 8px 0 0; padding-left: 12px; border-left: 2px solid var(--line); color: var(--muted); }
  .br { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .br a { text-decoration: none; } .br a:hover { text-decoration: underline; }
  .flood { position: absolute; inset: 0; background: var(--ink); clip-path: circle(0% at 90% 70%); pointer-events: none; opacity: 0; }
  .layer.flooding .flood { animation: flood 1s cubic-bezier(.5, 0, .3, 1) both; }
  @keyframes flood { 0% { clip-path: circle(0% at 90% 70%); opacity: 1; } 55% { clip-path: circle(150% at 90% 70%); opacity: 1; } 100% { clip-path: circle(150% at 90% 70%); opacity: 0; } }
  .seal { position: absolute; right: 12px; bottom: 12px; min-height: 40px; display: inline-flex; align-items: center; gap: 7px; padding: 0 14px 0 10px; border: 1px dashed var(--amber); border-radius: 999px; background: var(--surface); color: var(--amber-ink); font: 600 13px var(--mono); cursor: pointer; transition: transform .15s; }
  .seal svg { width: 15px; height: 15px; fill: var(--ink); }
  .seal:hover:not(:disabled) { transform: translateY(-2px); }
  .seal:disabled { cursor: not-allowed; border-style: solid; border-color: var(--line); color: var(--muted); }
  .layer.open .seal { display: none; }

  .p-end { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); color: var(--muted); font: 12px var(--mono); }
  .p-end svg { width: 22px; height: 22px; fill: var(--ink); }

  .hud { position: fixed; z-index: 50; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: flex-end; gap: 6px; pointer-events: none; }
  .hud-pill { pointer-events: auto; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); box-shadow: 0 6px 20px rgb(0 0 0 / .08); }
  .hud-pill svg { width: 20px; height: 20px; }
  .hud-drop { fill: var(--ink); } .hud-nib { stroke: var(--surface); stroke-width: 1.4; stroke-linecap: round; } .hud-hole { fill: var(--surface); }
  .hud-n { font: 600 16px var(--mono); color: var(--amber-ink); min-width: 2ch; }
  .hud-lv { font-size: 11px; }
  .hud-pill.bumpA { animation: bumpA .45s cubic-bezier(.3, 1.6, .5, 1); } .hud-pill.bumpB { animation: bumpB .45s cubic-bezier(.3, 1.6, .5, 1); }
  @keyframes bumpA { 35% { transform: scale(1.12); } } @keyframes bumpB { 35% { transform: scale(1.12); } }
  .hud-gain { order: -1; font: 600 13px var(--mono); color: var(--amber-ink); background: var(--amber-tint); padding: 3px 9px; border-radius: 999px; opacity: 0; }
  .hud-gain.show { animation: rise 1.1s ease-out both; }
  @keyframes rise { 0% { opacity: 0; transform: translateY(6px); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateY(-26px); } }

  .ink-toasts { position: fixed; z-index: 60; top: 16px; left: 50%; transform: translateX(-50%); width: min(420px, calc(100vw - 24px)); display: grid; gap: 8px; pointer-events: none; }
  .ink-toasts :global(.it) { pointer-events: auto; display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: center; padding: 14px 16px; border-radius: 14px; background: var(--ink); color: var(--bg); box-shadow: 0 14px 34px rgb(0 0 0 / .2); animation: it-in .5s cubic-bezier(.3, 1.4, .5, 1) both; }
  .ink-toasts :global(.it.out) { animation: it-out .3s ease-in forwards; }
  .ink-toasts :global(.it-badge) { width: 44px; height: 44px; border-radius: 50%; background: var(--amber); color: var(--ink); display: grid; place-items: center; font: 600 15px var(--mono); }
  .ink-toasts :global(.it-tag) { display: block; font: 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; opacity: .65; }
  .ink-toasts :global(.it-title) { display: block; font-weight: 600; font-size: 16px; }
  .ink-toasts :global(.it-desc) { display: block; font-size: 13px; opacity: .8; line-height: 1.4; }
  @keyframes it-in { from { opacity: 0; transform: translateY(-14px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes it-out { to { opacity: 0; transform: translateY(-8px); } }

  @media (prefers-reduced-motion: reduce) {
    .layer.flooding .flood { animation: none; } .l-content { transition: none; }
    .hud-pill.bumpA, .hud-pill.bumpB, .hud-gain.show { animation: none; }
    .ink-toasts :global(.it), .ink-toasts :global(.it.out) { animation-duration: .01s; }
  }
</style>
