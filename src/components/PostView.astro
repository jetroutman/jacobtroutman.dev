---
// One post, played like the company pages: an intro slide, one slide per heading, an end slide.
// Free claims earn ink; sealed layers cost ink (src/scripts/ink.ts). Slide nav: src/scripts/post-deck.ts.
// Used by /posts/<slug>/ (Published) and /admin/<slug>/ (any status, locked to the admin role).
import InkCard from './InkCard.astro';
import { INK, inline, published, type Post } from '../lib/posts';
interface Props { post: Post; admin?: string | false } // admin = the list's base path, e.g. /admin/
const { post, admin = false } = Astro.props;
const drop = 'M12 2.5C12 2.5 5.2 10.4 5.2 15.2a6.8 6.8 0 0 0 13.6 0C18.8 10.4 12 2.5 12 2.5Z';

type B = Post['body'][number];
const slides: { id: string; title: string | null; blocks: B[] }[] = [{ id: 'intro', title: null, blocks: [] }];
for (const b of post.body) {
  if (b.k === 'h') slides.push({ id: `s${slides.length}`, title: b.t, blocks: [] });
  else slides.at(-1)!.blocks.push(b);
}
// The intro is a title slide only; anything before the first heading gets its own opening slide.
if (slides[0].blocks.length) slides.splice(1, 0, { id: 'open', title: null, blocks: slides[0].blocks.splice(0) });
const all = [...slides, { id: 'end', title: 'The end', blocks: [] as B[] }];
const label = (s: { id: string; title: string | null }) => (s.title ? plain(s.title) : s.id === 'open' ? 'Opening' : 'Intro');
const plain = (t: string) => t.replace(/\*+/g, '');
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: string | null) => (d ? new Date(`${d.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : null);
const maxInk = post.cardCount * INK.cardReached + INK.postFinished;
const others = published.filter((p) => p.id !== post.id).slice(0, 3);
---
<div class="pdeck" data-post={post.id} data-admin={admin ? '1' : undefined}>
  <nav class="deckbar" aria-label="Sections">
    <ol class="segs">
      {all.map((s, i) => <li><a class="seg" href={`#${s.id}`} data-seg={s.id} aria-label={`${pad(i + 1)}: ${label(s)}`}><span></span></a></li>)}
    </ol>
    <span class="mono-meta bar-pos" aria-live="polite"><span data-pos>01</span> / {pad(all.length)}<span class="bar-label"> · <span data-label>Intro</span></span></span>
    {admin && (
      <span class="test">
        <button type="button" class="test-btn" data-test-toggle aria-expanded="false" aria-controls="test-menu">Test</button>
        <span class="test-menu" id="test-menu" data-test-menu hidden>
          <button type="button" data-ink-reset>Reset my ink</button>
          <button type="button" data-ink-recruiter>Arrive as a recruiter (+100)</button>
        </span>
      </span>
    )}
    <span class="hud" data-hud aria-label="Your ink">
      <span class="hud-gain" data-gain aria-live="polite"></span>
      <span class="hud-pill" data-hud-pill>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop} class="hud-drop"></path><path d="M12 10.6V16.4" class="hud-nib"></path><circle cx="12" cy="9.4" r="1.25" class="hud-hole"></circle></svg>
        <span class="hud-n" data-wallet>0</span>
        <span class="hud-lv mono-meta" data-level>Elementary</span>
      </span>
    </span>
  </nav>

  {all.map((s, i) => (
    <section id={s.id} class:list={['slide', s.id === 'intro' && 'intro', s.id === 'end' && 'end']} data-slide data-title={label(s)}>
      <div class="inner">
        {s.id === 'intro' && (
          <>
            <p class="mono-meta reveal crumbs">{admin ? <a href={admin}>← All posts</a> : <a href="/" data-back>← Decision log</a>} <span class="chip">{admin ? post.status : 'Post'}</span> {fmt(post.published) || (admin ? `Edited ${fmt(post.edited)}` : '')} · {post.minutes} min</p>
            <h1 class="p-title reveal">{post.title}</h1>
            {post.hook && <p class="p-hook reveal">{post.hook}</p>}
          </>
        )}
        {s.title && s.id !== 'end' && <div class="section-head reveal"><span class="num">{pad(i)}</span><h2 set:html={inline(s.title)} /></div>}
        {s.blocks.length > 0 && (
          <div class="flow">
            {s.blocks.map((b) => b.k === 'card'
              ? (b.card ? <div class="reveal"><InkCard card={b.card} /></div> : admin ? <p class="missing mono-meta reveal">Card {b.id.slice(0, 8)} isn't on the site (Private, or not synced yet).</p> : null)
              : b.k === 'q' ? <blockquote class="p-q reveal" set:html={inline(b.t)} />
              : b.k === 'li' ? <p class="p-li reveal" set:html={inline(b.t)} />
              : <p class="p-p reveal" set:html={inline(b.t)} />)}
          </div>
        )}
        {s.id === 'intro' && (
          <div class="howto reveal">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={drop}></path></svg>
            <p>Reading earns ink: {INK.cardReached} for every card you reach, {INK.postFinished} for finishing. Spend it to unseal where an idea came from and where it went. Up to {maxInk} ink in this post.</p>
          </div>
        )}
        {s.id === 'intro' && <p class="mono-meta hint reveal" aria-hidden="true">Scroll down ↓</p>}
        {s.id === 'end' && (
          <div class="end-box" data-post-end>
            <div class="section-head reveal"><span class="num">{pad(i)}</span><h2>That's the post</h2></div>
            <p class="p-p reveal">You earned <strong data-earned-here>0</strong> of {maxInk} ink here. Anything you unsealed stays open in my <a href="/library/">library</a> and <a href="/notes/">notes</a>.</p>
            {post.bookLinks.length > 0 && <p class="p-p reveal">This post drew on {post.bookLinks.map((b, k) => <>{k > 0 && ', '}<a href={b.href}><em>{b.title}</em></a></>)}.</p>}
            {others.length > 0 && (
              <ul class="more reveal">
                {others.map((o) => <li><a href={`/posts/${o.slug}/`}><span class="t">{o.title}</span>{o.hook && <span class="h">{o.hook}</span>}</a></li>)}
              </ul>
            )}
          </div>
        )}
      </div>
    </section>
  ))}
</div>
<div class="ink-toasts" data-ink-toasts aria-live="polite"></div>
<script type="application/json" data-ink-config set:html={JSON.stringify(INK)} />

<script>
  import { initInk } from '../scripts/ink';
  import { initPostDeck } from '../scripts/post-deck';
  initPostDeck();
  initInk();
  // Admin test menu
  const tb = document.querySelector<HTMLButtonElement>('[data-test-toggle]'), tm = document.querySelector<HTMLElement>('[data-test-menu]');
  if (tb && tm) {
    tb.addEventListener('click', () => { tm.hidden = !tm.hidden; tb.setAttribute('aria-expanded', String(!tm.hidden)); });
    for (const b of tm.querySelectorAll('button')) b.addEventListener('click', () => { tm.hidden = true; tb.setAttribute('aria-expanded', 'false'); });
    document.addEventListener('click', (e) => { if (!tm.hidden && !(e.target as Element).closest('.test')) { tm.hidden = true; tb.setAttribute('aria-expanded', 'false'); } });
  }
</script>

<style>
  :global(html:has(.pdeck)) { scroll-snap-type: y proximity; scroll-padding-top: var(--bar-h); --bar-h: 48px; }
  .deckbar { position: sticky; top: 0; z-index: 30; height: var(--bar-h); display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 16px; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter); background: var(--bg); border-bottom: 1px solid var(--line); }
  .segs { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; }
  .segs li { flex: 1; }
  .seg { position: relative; display: block; padding: 10px 0; }
  .seg span { display: block; height: 4px; border-radius: 999px; background: var(--line); transition: background 200ms ease-out; }
  .seg:global(.done) span { background: var(--amber); }
  .seg:global(.current) span { background: var(--ink); }
  .seg:hover span { background: var(--muted); }
  .bar-pos { white-space: nowrap; }
  @media (max-width: 900px) { .bar-label { display: none; } }
  @media (max-width: 520px) { .bar-pos { display: none; } .deckbar { grid-template-columns: 1fr auto auto; gap: 10px; } }

  .test { position: relative; }
  .test-btn { min-height: 32px; padding: 0 12px; border: 1px dashed var(--amber); border-radius: 999px; background: var(--amber-tint); color: var(--amber-ink); font: 12px var(--mono); cursor: pointer; }
  .test-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 40; display: grid; gap: 4px; min-width: 240px; padding: 6px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: 0 10px 30px rgb(0 0 0 / .12); }
  .test-menu[hidden] { display: none; }
  .test-menu button { min-height: 40px; padding: 0 12px; border: 0; border-radius: 8px; background: none; text-align: left; font-size: 14px; cursor: pointer; }
  .test-menu button:hover { background: var(--hover); }
  .hud { position: relative; display: flex; align-items: center; }
  .hud-pill { display: inline-flex; align-items: center; gap: 7px; padding: 4px 11px 4px 8px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .hud-pill svg { width: 18px; height: 18px; }
  .hud-drop { fill: var(--ink); } .hud-nib { stroke: var(--surface); stroke-width: 1.4; stroke-linecap: round; } .hud-hole { fill: var(--surface); }
  .hud-n { font: 600 14px var(--mono); color: var(--amber-ink); min-width: 2ch; font-variant-numeric: tabular-nums; }
  .hud-lv { font-size: 11px; }
  @media (max-width: 420px) { .hud-lv { display: none; } }
  .hud-pill:global(.bumpA) { animation: bumpA .45s cubic-bezier(.3, 1.6, .5, 1); } .hud-pill:global(.bumpB) { animation: bumpB .45s cubic-bezier(.3, 1.6, .5, 1); }
  @keyframes bumpA { 35% { transform: scale(1.12); } } @keyframes bumpB { 35% { transform: scale(1.12); } }
  .hud-gain { position: absolute; right: 0; top: calc(100% + 6px); white-space: nowrap; font: 600 12px var(--mono); color: var(--amber-ink); background: var(--amber-tint); padding: 3px 9px; border-radius: 999px; opacity: 0; pointer-events: none; }
  .hud-gain:global(.show) { animation: drop-in 1.3s ease-out both; }
  @keyframes drop-in { 0% { opacity: 0; transform: translateY(-6px); } 18% { opacity: 1; transform: none; } 75% { opacity: 1; } 100% { opacity: 0; transform: translateY(4px); } }

  .slide { min-height: calc(100svh - var(--bar-h)); scroll-snap-align: start; display: grid; align-content: center; padding: clamp(44px, 7vh, 80px) 0; }
  .inner { width: 100%; max-width: 760px; }
  :global(.deck-js) .reveal { opacity: 0; transform: translateY(14px); transition: opacity 420ms ease-out, transform 420ms ease-out; }
  :global(.deck-js) .shown .reveal { opacity: 1; transform: none; }
  .shown .reveal:nth-child(2) { transition-delay: 70ms; }
  .shown .reveal:nth-child(3) { transition-delay: 140ms; }
  .shown .reveal:nth-child(n+4) { transition-delay: 210ms; }

  .crumbs a { text-decoration: none; } .crumbs a:hover { text-decoration: underline; }
  .chip { border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; margin: 0 4px; }
  .p-title { margin-top: 18px; font-size: clamp(38px, 6vw, 72px); line-height: 1.02; letter-spacing: -0.03em; text-wrap: balance; }
  .p-hook { margin-top: 20px; max-width: 32em; font-size: clamp(20px, 2.2vw, 25px); line-height: 1.4; font-weight: 500; }
  .howto { margin-top: 32px; display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; max-width: 36em; padding: 14px 16px; border: 1px dashed var(--amber); border-radius: 12px; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .howto svg { width: 20px; height: 20px; fill: var(--ink); margin-top: 1px; }
  .hint { margin-top: clamp(28px, 5vh, 56px); }

  .section-head h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance; }
  .flow { margin-top: 24px; display: grid; gap: 18px; font-family: var(--reading); font-size: clamp(17px, 1.6vw, 19px); line-height: 1.6; }
  .intro .flow { margin-top: 28px; }
  .p-li { padding-left: 18px; position: relative; } .p-li::before { content: "–"; position: absolute; left: 0; color: var(--muted); }
  .p-q { margin: 0; padding-left: 16px; border-left: 2px solid var(--line); color: var(--muted); }
  .missing { padding: 10px 12px; border: 1px dashed var(--line); border-radius: 8px; }

  .end-box .p-p { margin-top: 18px; font-size: 18px; line-height: 1.6; }
  .more { list-style: none; padding: 0; margin: 28px 0 0; border-top: 1px solid var(--line); }
  .more a { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .more .t { font-weight: 600; } .more .h { color: var(--muted); font-size: 15px; }
  .more a:hover .t { text-decoration: underline; }

  .ink-toasts { position: fixed; z-index: 60; top: calc(var(--bar-h) + 10px); left: 50%; transform: translateX(-50%); width: min(420px, calc(100vw - 24px)); display: grid; gap: 8px; pointer-events: none; }
  .ink-toasts :global(.it) { pointer-events: auto; display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: center; padding: 14px 16px; border-radius: 14px; background: var(--ink); color: var(--bg); box-shadow: 0 14px 34px rgb(0 0 0 / .2); animation: it-in .5s cubic-bezier(.3, 1.4, .5, 1) both; }
  .ink-toasts :global(.it.out) { animation: it-out .3s ease-in forwards; }
  .ink-toasts :global(.it-badge) { width: 44px; height: 44px; border-radius: 50%; background: var(--amber); color: var(--ink); display: grid; place-items: center; font: 600 15px var(--mono); }
  .ink-toasts :global(.it-tag) { display: block; font: 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; opacity: .65; }
  .ink-toasts :global(.it-title) { display: block; font-weight: 600; font-size: 16px; }
  .ink-toasts :global(.it-desc) { display: block; font-size: 13px; opacity: .8; line-height: 1.4; }
  @keyframes it-in { from { opacity: 0; transform: translateY(-14px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes it-out { to { opacity: 0; transform: translateY(-8px); } }

  @media (prefers-reduced-motion: reduce) {
    :global(.deck-js) .reveal { transform: none; transition: opacity 200ms linear; transition-delay: 0ms !important; }
    .hud-pill:global(.bumpA), .hud-pill:global(.bumpB), .hud-gain:global(.show) { animation: none; }
    .ink-toasts :global(.it), .ink-toasts :global(.it.out) { animation-duration: .01s; }
  }
</style>
