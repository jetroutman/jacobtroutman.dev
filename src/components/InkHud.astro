---
import '../styles/components/ink-hud.css';
// The ink counter. "bar" sits in a post's sticky bar; "float" pins bottom-right (book pages).
interface Props { variant?: 'bar' | 'float' }
const { variant = 'bar' } = Astro.props;
const drop = 'M12 2.5C12 2.5 5.2 10.4 5.2 15.2a6.8 6.8 0 0 0 13.6 0C18.8 10.4 12 2.5 12 2.5Z';
---
<span class:list={['hud', variant, 'c', 'c-ink-hud']} data-hud aria-label="Your ink">
  <span class="hud-gain" data-gain aria-live="polite"></span>
  <span class="hud-pill" data-hud-pill>
    <svg viewBox="0 0 24 24" aria-hidden="true" data-hud-drop><path d={drop} class="hud-drop"></path><path d="M12 10.6V16.4" class="hud-nib"></path><circle cx="12" cy="9.4" r="1.25" class="hud-hole"></circle></svg>
    <span class="hud-n" data-wallet>0</span>
    <span class="hud-lv mono-meta" data-level>Elementary</span>
    <span class="hud-meter" data-bonus-meter title="Fills toward the next bonus" aria-hidden="true"><span></span></span>
  </span>
</span>
