---
import '../styles/components/pdo.css';
interface Props { tldr: { problem: string; decision: string; outcome: string }; size?: number }
const { tldr, size = 15 } = Astro.props;
---
<div class="pdo-grid c c-pdo" style={`--pdo-size:${size}px`}>
  <div class="pdo"><p class="mono-label">Problem</p><p>{tldr.problem}</p></div>
  <div class="pdo"><p class="mono-label">Decision</p><p>{tldr.decision}</p></div>
  <div class="pdo"><p class="mono-label">Outcome</p><p>{tldr.outcome}</p></div>
</div>
