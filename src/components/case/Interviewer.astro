---
import '../../styles/components/interviewer.css';
interface Props { points: [string, string][] }
const { points } = Astro.props;
---
<ol class="points c c-interviewer">
  {points.map(([point, detail], i) => (
    <li><span class="n">{String(i + 1).padStart(2, '0')}</span><div><p class="point">{point}</p><p class="detail">{detail}</p></div></li>
  ))}
</ol>
