---
import '../../styles/components/parts.css';
interface Props { label?: string; items: [string, string][] }
const { label, items } = Astro.props;
---
{label && <p class="mono-label parts-label c c-parts">{label}</p>}
<dl class="parts c c-parts">
  {items.map(([term, def]) => <div><dt>{term}</dt><dd>{def}</dd></div>)}
</dl>
