---
import '../../styles/components/case-section.css';
interface Props { id: string; n: string; title: string; lede?: string }
const { id, n, title, lede } = Astro.props;
---
<section id={id} class="case-section c-case-section" data-section>
  <div class="section-head"><span class="num">{n}</span><h2>{title}</h2></div>
  {lede && <p class="lede">{lede}</p>}
  <div class="section-body"><slot /></div>
</section>
